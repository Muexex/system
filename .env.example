# 虚构演示账号开关。false 时没有正式登录入口。
APP_DEMO_MODE=true
# 文件路径相对于项目根目录；仅用于有持久化磁盘的单实例。
DATABASE_URL=file:./data/dev.db
UPLOAD_DIR=./data/uploads
RTC_PROVIDER=demo
# 真实音视频可选；密钥只能存在服务端，不使用 NEXT_PUBLIC 前缀。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 服务端集中时限（毫秒）
MATCH_WAIT_MS=60000
MATCH_OFFER_MS=20000
HEARTBEAT_TTL_MS=30000
SESSION_ABANDONED_MS=1800000

# HTTPS反向代理使用时填写准确外部源（本机开发可留空，自动校验Host）
APP_ORIGIN=

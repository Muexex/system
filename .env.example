# 文件路径相对于项目根目录；仅用于有持久化磁盘的单实例。
DATABASE_URL=file:./data/dev.db
UPLOAD_DIR=./data/uploads
RTC_PROVIDER=demo
# 真实音视频可选；密钥只能存在服务端，不使用 NEXT_PUBLIC 前缀。
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# 服务端集中时限（毫秒）
MATCH_WAIT_MS=60000
MATCH_OFFER_MS=20000
HEARTBEAT_TTL_MS=30000
SESSION_ABANDONED_MS=1800000

# HTTPS反向代理使用时填写准确外部源（本机开发可留空，自动校验Host）
APP_ORIGIN=

# 运行日志与监督进程。日志不含密码、Cookie或聊天正文。
LOG_DIR=./data/logs
LOG_MAX_BYTES=262144
LOG_ROTATE_FILES=3
SERVER_MAX_RESTARTS=3
SERVER_RESTART_WINDOW_MS=600000
SERVER_RESTART_DELAY_MS=1000
SERVER_STOP_TIMEOUT_MS=5000
